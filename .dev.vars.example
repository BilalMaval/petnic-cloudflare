# Names only. Copy to .dev.vars (git-ignored) and fill in locally.
NEXTJS_ENV=development

# Build-time (also set as Build variables in Workers Builds)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Runtime secrets
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=
PAYPAL_WEBHOOK_ID=
CJ_ACCESS_TOKEN=
AI_HORDE_API_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
